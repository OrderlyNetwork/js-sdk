{
  "name": "@orderly.network/storybook",
  "private": true,
  "version": "2.1.8",
  "type": "module",
  "scripts": {
    "dev": "pnpm loadEnv vite",
    "build:tsc": "tsc -b && vite build",
    "build:vite": "NODE_OPTIONS=--max_old_space_size=6096 vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "tailwind": "tailwindcss -i ./src/tailwind.css -o ./dist/tailwind.css",
    "storybook": "pnpm loadEnv storybook dev -p 6006",
    "loadEnv": "pnpm dotenv -e .env.local -e .env --",
    "storybook:tradingPage": "storybook dev -p 6006 --initial-path=/story/package-trading-tradingpage--page",
    "build-storybook": "cross-env NODE_ENV=production NODE_OPTIONS=--max_old_space_size=4500 storybook build",
    "build-storybook:test": "cross-env NODE_ENV=production NODE_OPTIONS=--max_old_space_size=4096 storybook build --test"
  },
