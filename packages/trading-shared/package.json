{
  "name": "@orderly.network/trading-shared",
  "version": "3.2.2",
  "description": "Shared trading panels, order book primitives, preferences, and contracts",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.build.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@orderly.network/hooks": "workspace:*",
    "@orderly.network/i18n": "workspace:*",
    "@orderly.network/markets-core": "workspace:*",
    "@orderly.network/react-app": "workspace:*",
    "@orderly.network/types": "workspace:*",
    "@orderly.network/ui": "workspace:*",
    "@orderly.network/ui-positions": "workspace:*",
    "@orderly.network/ui-share": "workspace:*",
    "@orderly.network/ui-tradingview": "workspace:*",
    "@orderly.network/utils": "workspace:*",
    "@orderly.network/plugin-core": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "^18.3.2",
    "@types/react-dom": "^18.3.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsconfig": "workspace:*",
    "tsup": "^8.5.1",
    "typescript": "^5.1.6"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  }
}
