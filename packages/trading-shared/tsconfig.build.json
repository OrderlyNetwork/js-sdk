{
  "extends": "tsconfig/react-library.json",
  "include": ["./src/**/*.ts", "./src/**/*.tsx"],
  "exclude": [
    "dist",
    "build",
    "node_modules",
    "**/*.test.tsx",
    "**/*.test.ts",
    "**/*.spec.tsx",
    "**/*.spec.ts"
  ],
  "compilerOptions": {
    "jsx": "react-jsx",
    "sourceMap": false,
    "module": "esnext",
    "outDir": "dist",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "target": "ES2022",
    "typeRoots": ["./node_modules/@types", "./src/@types"],
    "moduleResolution": "node"
  }
}
