{
  "name": "@orderly.network/prediction",
  "version": "3.2.3",
  "description": "Prediction market UI prototype for Orderly",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup && pnpm run build:css",
    "build:css": "tailwindcss build -i src/tailwind.css -o dist/styles.css --minify",
    "lint": "eslint src --max-warnings=0",
    "test": "find src -name '*.test.ts' -print0 | xargs -0 tsx --test",
    "typecheck": "tsc --noEmit -p tsconfig.build.json"
  },
  "keywords": [
    "Orderly",
    "Prediction market",
    "UI"
  ],
  "files": [
    "dist",
    "docs"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@orderly.network/core": "workspace:*",
    "@orderly.network/hooks": "workspace:*",
    "@orderly.network/i18n": "workspace:*",
    "@orderly.network/markets-core": "workspace:*",
    "@orderly.network/net": "workspace:*",
    "@orderly.network/perp": "workspace:*",
    "@orderly.network/react-app": "workspace:*",
    "@orderly.network/trading-shared": "workspace:*",
    "@orderly.network/types": "workspace:*",
    "@orderly.network/ui": "workspace:*",
    "@orderly.network/ui-connector": "workspace:*",
    "@orderly.network/ui-order-entry": "workspace:*",
    "@orderly.network/ui-orders": "workspace:*",
    "@orderly.network/ui-positions": "workspace:*",
    "@orderly.network/ui-scaffold": "workspace:*",
    "@orderly.network/utils": "workspace:*",
    "@orderly.network/ui-assets": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "^18.3.2",
    "@types/react-dom": "^18.3.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tailwindcss": "^3.4.19",
    "tsconfig": "workspace:*",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^5.1.6"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  }
}