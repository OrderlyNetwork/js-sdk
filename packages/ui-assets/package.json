{
  "name": "@orderly.network/ui-assets",
  "version": "3.4.0-alpha.0",
  "description": "Shared asset views, conversion history, account filters, and deposit helpers",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup && pnpm run build:css",
    "build:css": "tailwindcss build -i src/tailwind.css -o dist/styles.css --minify",
    "typecheck": "tsc --noEmit -p tsconfig.build.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@orderly.network/hooks": "workspace:*",
    "@orderly.network/i18n": "workspace:*",
    "@orderly.network/perp": "workspace:*",
    "@orderly.network/react-app": "workspace:*",
    "@orderly.network/types": "workspace:*",
    "@orderly.network/ui": "workspace:*",
    "@orderly.network/ui-connector": "workspace:*",
    "@orderly.network/ui-order-entry": "workspace:*",
    "@orderly.network/ui-transfer": "workspace:*",
    "@orderly.network/utils": "workspace:*",
    "date-fns": "^3.6.0",
    "immer": "^10.1.1",
    "ramda": "^0.29.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.2",
    "@types/react-dom": "^18.3.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsconfig": "workspace:*",
    "tsup": "^8.5.1",
    "typescript": "^5.1.6",
    "@types/ramda": "^0.29.3",
    "tailwindcss": "^3.4.19"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  }
}
