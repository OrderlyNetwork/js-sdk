{
  "name": "@orderly.network/react-app",
  "version": "3.1.9-alpha.0",
  "description": "Create React App with Orderly Network components",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "scripts": {
    "build": "tsup && pnpm run build:css",
    "build:css": "tailwindcss build -i src/tailwind.css -o dist/styles.css --minify",
    "test": "vitest run"
  },
  "keywords": [
    "Orderly",
    "Exchange",
    "React",
    "DApp"
  ],
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@orderly.network/ui": "workspace:*",
    "@orderly.network/hooks": "workspace:*",
    "@orderly.network/i18n": "workspace:*",
    "@orderly.network/utils": "workspace:*",
    "@orderly.network/types": "workspace:*",
    "date-fns": "^3.6.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-typescript": "^7.22.5",
    "@testing-library/react": "^14.2.1",
    "@types/react": "^18.3.2",
    "@types/react-dom": "^18.3.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "jsdom": "^20.0.3",
    "tsconfig": "workspace:*",
    "tailwindcss": "^3.4.19",
    "tsup": "^8.5.1",
    "typescript": "^5.1.6",
    "vitest": "^4.1.10"
  },
  "react": ">=18",
  "react-dom": ">=18"
}
